# Example environment variables for omnideck

# LLM host override for Ollama AsyncClient
# Leave empty to use library defaults.
LLM_HOST=

# Anthropic API key (required when llm.provider is "anthropic")
# Get yours at: https://console.anthropic.com
LLM_API_KEY=

# Telegram notifications for routine completion/failure
# Create a bot via @BotFather, then message it and check
# https://api.telegram.org/bot<TOKEN>/getUpdates for your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

