{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/features/conversation/events/*.js",
    "src/features/conversation/events/*.ts"
  ],
  "exclude": ["src/features/conversation/events/__tests__"]
}
