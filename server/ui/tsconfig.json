{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/features/conversation/events/*.js",
    "src/features/conversation/events/*.ts",
    "src/features/conversation/catalog/activityTypes.ts",
    "src/features/conversation/catalog/activityReducer.js",
    "src/features/conversation/catalog/useConversationActivity.js",
    "src/features/conversation/transport/conversationActivityClient.js"
  ],
  "exclude": [
    "src/features/conversation/events/__tests__"
  ]
}
