{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omnideck",
  "version": "0.1.0-alpha.10",
  "identifier": "dev.omnideck.desktop",
  "build": {
    "beforeBundleCommand": "node scripts/prepare-icon-assets.mjs",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["setup-local"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private AI agents running on your computer",
    "longDescription": "omnideck runs a private agent workspace in a local Podman environment.",
    "externalBin": ["binaries/omnideck-cli"],
    "useLocalToolsDir": true,
    "macOS": {
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
