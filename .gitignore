# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment directories
venv/
env/
.venv/

# Build artifacts
build/
dist/
*.egg-info/

# Testing and coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
test-results/
playwright-report/
artifacts/desktop-hardware/
artifacts/desktop-release-contract/

# Type checking and linting caches
.mypy_cache/
.ruff_cache/

# Runtime caches (created when source is mounted in container-dev)
.cache/
.pnpm-store/

# Data migration state
.migrations.json
*.pre_migration_*.json

# Logs
logs/
*.log

# Editor-specific files
.idea/

# Claude Code runtime state (scheduler locks, local settings, agent worktrees)
.claude/

# OS generated files
.DS_Store

# Desktop shell dependencies and build products
desktop/node_modules/
desktop/dist/
desktop/build/runtime/

# Environment variables
.env

# Developer config override
config.dev.yaml

# Node projects
node_modules/
**/node_modules/
