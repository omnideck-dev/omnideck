{
  "id": "local.sum_list",
  "version": "1",
  "scope": "local",
  "title": "Sum a list via repeated add",
  "input_schema": {
    "type": "object",
    "properties": {
      "numbers": { "type": "array", "items": { "type": "integer" } }
    },
    "required": ["numbers"]
  },
  "output_schema": {
    "type": "object",
    "properties": { "total": { "type": "integer" } },
    "required": ["total"]
  },
  "implementation": { "kind": "python_script", "path": "implementation.py" },
  "runtime": { "kind": "python", "version": "3.12" },
  "callable_dependencies": ["omnideck.add@1"]
}
